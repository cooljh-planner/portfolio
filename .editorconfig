# 에디터(VS Code 등)가 읽어서 저장 방식을 맞춰 줍니다. 없어도 사이트는 동작합니다.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# 마크다운은 줄 끝 공백 두 칸이 줄바꿈 의미를 가지므로 지우지 않습니다.
[*.md]
trim_trailing_whitespace = false

# 윈도우 배치 파일은 CRLF
[*.bat]
end_of_line = crlf
